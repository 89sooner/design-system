{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/check-foundation-tokens.mjs && node scripts/build-component-catalog.mjs && node scripts/build-contrast-report.mjs && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "pretypecheck": "node scripts/build-component-catalog.mjs && node scripts/build-contrast-report.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@conductor/css": "workspace:*",
    "@conductor/react": "workspace:*",
    "@conductor/tokens": "workspace:*",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3"
  }
}
