# Generated token artifacts. The token source (schema/primitives/palette/scales/
# components) is the only input; these are emitted by `pnpm --filter @conductor/tokens
# run build`. Committing them would create a second source of truth that can drift.
# Refs: CR-009 DEV-002 FR-TOK-001
packages/tokens/src/tokens.ts
packages/tokens/src/breakpoints.ts
apps/docs/src/generated/component-meta.json
apps/docs/src/generated/contrast-report.ts

