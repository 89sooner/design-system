{
  "name": "conductor-design-system",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm lint:deps && pnpm --filter @conductor-by-89soone/tokens run build && pnpm --filter @conductor-by-89soone/css run build && pnpm --filter @conductor-by-89soone/react run build && pnpm --filter docs run build",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:deps": "node scripts/check-deps.mjs",
    "lint:tokens": "node packages/tokens/bin/conductor-lint-tokens.mjs packages/css packages/react apps/docs/src",
    "check:contrast": "pnpm --filter @conductor-by-89soone/tokens run check:contrast",
    "test:a11y": "vitest run --config vitest.a11y.config.ts",
    "test:visual": "node scripts/test-visual.mjs",
    "size": "node scripts/check-size.mjs",
    "changeset": "changeset",
    "check:changesets": "node scripts/check-changesets.mjs",
    "check:api": "node scripts/check-api.mjs",
    "check:release-tags": "node scripts/check-release-tags.mjs",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "lighthouse": "node scripts/check-lighthouse.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "human-id": "4.1.1",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "fast-uri@<3.1.5": "3.1.5",
      "js-yaml@>=3.0.0 <3.15.1": "3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<8.5.18": "8.5.18",
      "react-router@>=7.12.0 <7.18.2": "7.18.2"
    }
  },
  "devDependencies": {
    "@changesets/cli": "2",
    "@eslint/js": "^9.19.0",
    "@microsoft/api-extractor": "7",
    "@size-limit/esbuild": "11",
    "@size-limit/file": "11",
    "@types/node": "^22.13.0",
    "@vitest/browser": "3.2.7",
    "axe-core": "4.10.3",
    "eslint": "^9.19.0",
    "globals": "^15.14.0",
    "lighthouse": "^13.4.0",
    "playwright": "1.61.1",
    "size-limit": "11",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vitest": "^3.0.4"
  }
}
