{
  "name": "conductor-design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm lint:deps && pnpm --filter @conductor/tokens run build && pnpm --filter @conductor/css run build && pnpm --filter @conductor/react run build && pnpm --filter docs run build",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:deps": "node scripts/check-deps.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vitest": "^3.0.4"
  }
}
