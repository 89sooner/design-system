{
  "name": "conductor-design-system",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm lint:deps && pnpm --filter @conductor-by-89soone/tokens run build && pnpm --filter @conductor-by-89soone/css run build && pnpm --filter @conductor-by-89soone/react run build && pnpm --filter docs run build",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:deps": "node scripts/check-deps.mjs",
    "lint:tokens": "node packages/tokens/bin/conductor-lint-tokens.mjs packages/css packages/react apps/docs/src",
    "check:contrast": "pnpm --filter @conductor-by-89soone/tokens run check:contrast",
    "test:a11y": "vitest run --config vitest.a11y.config.ts",
    "test:e2e": "pnpm --filter docs test:e2e",
    "test:cross": "pnpm --filter docs test:cross --project firefox --project webkit",
    "check:consumer": "node scripts/check-consumer.mjs",
    "test:visual": "node scripts/test-visual.mjs",
    "size": "node scripts/check-size.mjs",
    "changeset": "changeset",
    "check:changesets": "node scripts/check-changesets.mjs",
    "check:api": "node scripts/check-api.mjs",
    "check:release-tags": "node scripts/check-release-tags.mjs",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "lighthouse": "node scripts/check-lighthouse.mjs",
    "ds:artifact": "node tools/design-system-artifact/build.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "human-id": "4.1.1",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.6": "2.1.6",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "browserslist@<4.28.7": "4.28.8",
      "fast-uri@<3.1.9": "3.1.9",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<8.5.23": "8.5.23",
      "react-router@>=7.12.0 <7.18.2": "7.18.2",
      "source-map-js@<1.2.2": "1.2.2",
      "tinypool@<2.1.2": "2.1.2",
      "vite@>=6.0.0 <6.4.6": "6.4.6",
      "vite@>=7.0.0 <7.3.7": "7.3.7",
      "esbuild@>=0.27.3 <0.28.1": "0.28.2",
      "minimatch@>=7.0.0 <11.0.1": "11.0.9"
    }
  },
  "devDependencies": {
    "@changesets/cli": "2",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "7",
    "@size-limit/esbuild": "11",
    "@size-limit/file": "11",
    "@types/node": "^22.13.0",
    "@vitest/browser-playwright": "4.1.12",
    "axe-core": "4.10.3",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "lighthouse": "^13.5.0",
    "playwright": "1.61.1",
    "size-limit": "11",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "4.1.12"
  }
}
