{
  "name": "@conductor-by-89soone/tokens",
  "version": "0.1.0",
  "description": "Theme-aware design tokens and validation CLIs for Conductor.",
  "license": "MIT",
  "homepage": "https://89sooner.github.io/design-system/",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/89sooner/design-system.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "conductor-build-tokens": "./bin/conductor-build-tokens.mjs",
    "conductor-check-contrast": "./bin/conductor-check-contrast.mjs",
    "conductor-lint-tokens": "./bin/conductor-lint-tokens.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./contrast-report.json": "./dist/contrast-report.json",
    "./breakpoints": {
      "types": "./dist/breakpoints.d.ts",
      "import": "./dist/breakpoints.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup --config tsup.cli.config.ts && node ./bin/conductor-build-tokens.mjs && node ./bin/conductor-check-contrast.mjs && tsup",
    "check:contrast": "node ./bin/conductor-check-contrast.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
