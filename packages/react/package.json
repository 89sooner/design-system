{
  "name": "@conductor-by-89soone/react",
  "version": "0.0.0",
  "description": "Accessible React primitives for Conductor.",
  "license": "MIT",
  "homepage": "https://89sooner.github.io/design-system/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/89sooner/design-system.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "vitest run --project react src/testing/public-components.test.ts",
    "build": "tsup",
    "test": "vitest run --project react",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@conductor-by-89soone/css": "workspace:*",
    "@conductor-by-89soone/tokens": "workspace:*",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-checkbox": "1.3.2",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-select": "2.2.5",
    "@radix-ui/react-switch": "1.2.5",
    "@radix-ui/react-tooltip": "1.2.12"
  },
  "peerDependencies": {
    "lucide-react": "^0.400.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "jsdom": "^26.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
