{
  "name": "@conductor/css",
  "version": "0.0.0",
  "sideEffects": ["*.css"],
  "types": "./types/index.d.ts",
  "files": ["dist", "types"],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "style": "./dist/index.css",
      "default": "./dist/index.css"
    },
    "./component.css": {
      "style": "./dist/component.css",
      "default": "./dist/component.css"
    },
    "./package.json": "./package.json"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run --project css --config ../../vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@conductor/tokens": "workspace:*"
  },
  "devDependencies": {
    "browserslist": "^4.24.4",
    "lightningcss": "^1.29.1",
    "postcss": "^8.5.16",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
