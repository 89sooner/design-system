{
  "name": "@conductor-by-89soone/css",
  "version": "0.2.0",
  "description": "Framework-agnostic layered styles for Conductor.",
  "license": "MIT",
  "homepage": "https://89sooner.github.io/design-system/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/89sooner/design-system.git",
    "directory": "packages/css"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "types": "./types/index.d.ts",
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "style": "./dist/index.css",
      "default": "./dist/index.css"
    },
    "./component.css": {
      "style": "./dist/component.css",
      "default": "./dist/component.css"
    },
    "./package.json": "./package.json"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run --project css --config ../../vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@conductor-by-89soone/tokens": "workspace:*"
  },
  "devDependencies": {
    "browserslist": "^4.24.4",
    "lightningcss": "^1.29.1",
    "postcss": "^8.5.16",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
